# Puerto del servidor (en Render NO se configura, lo inyecta Render solo)
PORT=3000
# development | production
NODE_ENV=development
# URI de MongoDB Atlas (con usuario y contraseña). NUNCA subir la real.
MONGODB_URI=
# Secreto de Better Auth. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL publica del FRONTEND (las requests a /api llegan por el proxy / rewrite)
# Local: http://localhost:5173 | Produccion: https://<front>.onrender.com
BETTER_AUTH_URL=http://localhost:5173
# OAuth App de GitHub (una para local y otra para produccion)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
